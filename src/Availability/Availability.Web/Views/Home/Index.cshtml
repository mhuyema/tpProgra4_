@using Availability.Web.Models
@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    ViewData["FullWidth"] = true;
}

<partial name="Components/_Hero" model="Model.Hero" />

<div class="bombo-container">
    <section class="bombo-section" style="padding-bottom:0">
        <div class="bombo-chips">
            @foreach (var filter in Model.Filters)
            {
                <partial name="Components/_Chip" model="filter" />
            }
        </div>
    </section>

    <section class="bombo-section">
        <div class="bombo-section__head">
            <h2 class="bombo-headline-md">Cartelera</h2>
        </div>
        <div class="bombo-grid">
            @foreach (var ev in Model.Events)
            {
                <partial name="Components/_EventCard" model="ev" />
            }
        </div>
    </section>

    <section class="bombo-section">
        <div class="bombo-section__head">
            <h2 class="bombo-headline-md">Circuito aliado</h2>
        </div>
        <div class="bombo-grid">
            @foreach (var venue in Model.Venues)
            {
                <partial name="Components/_VenueCard" model="venue" />
            }
        </div>
    </section>

    <section class="bombo-section">
        <partial name="Components/_AppPromo" />
    </section>
</div>
