@using Availability.Web.Models
@using Availability.Web.Models.Components
@model LoginPanelBodyModel
@{
    var submit = new ButtonModel("Iniciar sesión", Type: "submit", Lock: true, LockText: "Ingresando…");
}
<form asp-controller="Reserva" asp-action="IniciarSesion" method="post" class="bombo-panel__form" data-login-form>
    <input type="hidden" name="EventoId" value="@Model.EventoId" />
    <div data-login-seat-inputs></div>
    @if (Model.Error is not null)
    {
        <div><partial name="Components/_Badge" model="new BadgeModel(Model.Error, true)" /></div>
    }
    <partial name="Components/_LoginFields" model="new LoginViewModel { Email = Model.Email ?? string.Empty }" />
    <partial name="Components/_Button" model="submit" />
</form>
