@using Availability.Web.Models.Components
@model EventCardModel
<a href="@Model.Href" class="bombo-event-card">
    <img class="bombo-event-card__img" src="@Model.ImageUrl" alt="@Model.Title" />
    <div class="bombo-event-card__shade"></div>
    @if (Model.BadgeText is not null)
    {
        <div class="bombo-event-card__badge">
            <partial name="Components/_Badge" model="new BadgeModel(Model.BadgeText, Model.BadgeIsError)" />
        </div>
    }
    <div class="bombo-event-card__body">
        <span class="bombo-label-md bombo-event-card__meta">@Model.Meta</span>
        <h3 class="bombo-headline-md">@Model.Title</h3>
    </div>
</a>
