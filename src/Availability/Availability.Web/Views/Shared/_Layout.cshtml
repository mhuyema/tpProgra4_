@using Availability.Web.Models.Components
@{
    var navbar = new NavbarModel(
        "BOMBO",
        new List<NavLinkModel>
        {
            new("Home", "Home", "Index"),
            new("Styleguide", "Styleguide", "Index"),
            new("Privacy", "Home", "Privacy")
        },
        ShowSearch: true,
        Regions: new List<string> { "Buenos Aires", "Córdoba", "Rosario", "Mendoza" },
        Login: new ButtonModel("Ingresar", "/Cuenta/Login", ButtonVariant.Primary));

    var footer = new FooterModel("BOMBO", new List<FooterLink>
    {
        new("Eventos", "/"),
        new("Privacidad", "/Home/Privacy"),
        new("Styleguide", "/Styleguide")
    });

    var fullWidth = ViewData["FullWidth"] as bool? ?? false;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Availability.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@700;800;900&family=Anton&family=Inter:wght@400;500&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bombo/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bombo/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bombo/sections.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Availability.Web.styles.css" asp-append-version="true" />
</head>
<body class="bombo">
    <header>
        <partial name="Components/_Navbar" model="navbar" />
    </header>
    @if (fullWidth)
    {
        <main role="main">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <partial name="Components/_Footer" model="footer" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/lock-click.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
