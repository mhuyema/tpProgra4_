@using Availability.Web.Models
@using Availability.Web.Models.Components
@model SeatSelectionViewModel
@{
    ViewData["Title"] = "Elegí tus asientos";
    ViewData["FullWidth"] = true;
    var confirm = new ButtonModel("Confirmar reserva", Type: "submit", Lock: true, LockText: "Reservando…");
}

<div class="bombo-container">
    <div class="bombo-section" style="padding-bottom:0">
        <span class="bombo-label-md" style="color:var(--primary-fixed)">Reserva</span>
        <h1 class="bombo-headline-lg">Elegí tus asientos</h1>
    </div>

    <div class="bombo-reserva">
        <section class="bombo-card">
            <partial name="Components/_SeatMap" model="Model.Map" />
        </section>

        <aside class="bombo-reserva__aside">
            <partial name="Components/_EventSummary" model="Model.Event" />

            <form method="post" asp-action="Confirmar" class="bombo-card bombo-reserva__selection">
                <input type="hidden" name="EventoId" value="@Model.EventoId" />
                <div data-seat-inputs></div>
                @if (TempData["Error"] is string error)
                {
                    <div style="margin-bottom:.75rem"><partial name="Components/_Badge" model="new BadgeModel(error, true)" /></div>
                }
                <div class="bombo-section__head" style="margin-bottom:.75rem">
                    <h3 class="bombo-headline-sm">Tu selección</h3>
                    <span class="bombo-label-md" data-seat-count>0 / @Model.Map.MaxSeats</span>
                </div>
                <ul class="bombo-reserva__list" data-seat-list>
                    <li class="bombo-body-sm bombo-reserva__empty">Todavía no elegiste butacas.</li>
                </ul>
                <div class="bombo-reserva__total">
                    <span class="bombo-label-md">Total</span>
                    <span class="bombo-headline-sm" data-seat-total>$ 0</span>
                </div>
                <div data-seat-cta>
                    <partial name="Components/_Button" model="confirm" />
                </div>
            </form>
        </aside>
    </div>
</div>

@section Scripts {
    <script src="~/js/seat-map.js" asp-append-version="true"></script>
}
