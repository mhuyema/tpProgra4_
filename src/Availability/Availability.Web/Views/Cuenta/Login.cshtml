@using Availability.Web.Models
@using Availability.Web.Models.Components
@model LoginViewModel
@{
    ViewData["Title"] = "Ingresar";
    ViewData["FullWidth"] = true;
    var submit = new ButtonModel("Ingresar", Type: "submit", Lock: true, LockText: "Ingresando…");
}

<div class="bombo-container bombo-auth">
    <div class="bombo-card bombo-auth__card">
        <span class="bombo-label-md" style="color:var(--primary-fixed)">Tu cuenta</span>
        <h1 class="bombo-headline-lg">Ingresar</h1>

        <form asp-action="Login" method="post" class="bombo-auth__form">
            <div class="bombo-field">
                <label asp-for="Email" class="bombo-label-md"></label>
                <input asp-for="Email" class="bombo-input" autocomplete="email" />
                <span asp-validation-for="Email" class="bombo-field__error"></span>
            </div>
            <div class="bombo-field">
                <label asp-for="Password" class="bombo-label-md"></label>
                <input asp-for="Password" class="bombo-input" autocomplete="current-password" />
                <span asp-validation-for="Password" class="bombo-field__error"></span>
            </div>
            <partial name="Components/_Button" model="submit" />
        </form>

        <p class="bombo-body-md bombo-auth__alt">
            ¿Primera vez en BOMBO?
            <a asp-action="Register">Registrate</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
