@using Availability.Web.Models
@using Availability.Web.Models.Components
@model RegisterViewModel
@{
    ViewData["Title"] = "Registrate";
    ViewData["FullWidth"] = true;
    var submit = new ButtonModel("Crear cuenta", Type: "submit", Lock: true, LockText: "Creando…");
}

<div class="bombo-container bombo-auth">
    <div class="bombo-card bombo-auth__card">
        <span class="bombo-label-md" style="color:var(--primary-fixed)">Primera cuenta</span>
        <h1 class="bombo-headline-lg">Registrate</h1>

        <form asp-action="Register" method="post" class="bombo-auth__form">
            <div class="bombo-field">
                <label asp-for="Name" class="bombo-label-md"></label>
                <input asp-for="Name" class="bombo-input" autocomplete="name" />
                <span asp-validation-for="Name" class="bombo-field__error"></span>
            </div>
            <div class="bombo-field">
                <label asp-for="Email" class="bombo-label-md"></label>
                <input asp-for="Email" class="bombo-input" autocomplete="email" />
                <span asp-validation-for="Email" class="bombo-field__error"></span>
            </div>
            <div class="bombo-field">
                <label asp-for="Password" class="bombo-label-md"></label>
                <input asp-for="Password" class="bombo-input" autocomplete="new-password" />
                <span asp-validation-for="Password" class="bombo-field__error"></span>
            </div>
            <div class="bombo-field">
                <label asp-for="ConfirmPassword" class="bombo-label-md"></label>
                <input asp-for="ConfirmPassword" class="bombo-input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="bombo-field__error"></span>
            </div>
            <partial name="Components/_Button" model="submit" />
        </form>

        <p class="bombo-body-md bombo-auth__alt">
            ¿Ya tenés cuenta?
            <a asp-action="Login">Ingresá</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
